# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# gegenereerde foto-varianten (scripts/build-images.mjs, draait bij elke build)
/public/images/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare
.wrangler/
# De secrets voor `wrangler dev`. Let op: dit valt NIET onder .env* hierboven —
# zonder deze regel belandt het adminwachtwoord in git. .dev.vars.example is de
# lege versie die wel meegaat.
.dev.vars
!.dev.vars.example

# typescript
*.tsbuildinfo
next-env.d.ts
# gegenereerd door `npm run cf-typegen` (levert het Env-type uit wrangler.jsonc)
worker-configuration.d.ts
