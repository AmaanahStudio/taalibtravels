{
	// OpenNext (`opennextjs-cloudflare build`) serveert alles buiten /api/*:
	// pagina's, assets en de 404. `worker/index.ts` is de entry en handelt /api/*
	// zelf eerst af; de rest gaat door naar de OpenNext-handler.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taalibtravels",
	"main": "./worker/index.ts",
	// Moet een datum zijn die de geïnstalleerde wrangler ook aankan: de
	// workerd-binary van 4.121.0 gaat tot 2026-08-11. Zolang er geen `main` was,
	// startte er lokaal geen runtime en viel een te hoge datum niet op.
	// Verhoog deze pas samen met wrangler zelf.
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Zonder deze twee regels zet `wrangler deploy` de workers.dev-URL bij elke
	// deploy weer aan. De site zou dan op twee adressen te vinden zijn, wat de
	// canonical uit site.json ondermijnt.
	"workers_dev": false,
	"preview_urls": false,
	// De domeinen waarop deze Worker draait. Deze stonden eerder alleen in het
	// dashboard: `wrangler deploy` overschrijft de remote configuratie met deze
	// file, en zonder dit blok haalt een deploy dus de koppeling met het domein
	// weg — de site is daarna onbereikbaar op taalibtravels.com. Verwijder ze
	// hier dus niet "omdat ze toch in het dashboard staan".
	"routes": [
		{ "pattern": "taalibtravels.com", "custom_domain": true },
		{ "pattern": "www.taalibtravels.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./.open-next/assets",
		// Door OpenNext gebruikt om statische bestanden op te vragen.
		"binding": "ASSETS"
		// Geen `run_worker_first` meer: bestanden uit assets winnen vanzelf, al het
		// andere (ook /api/*) valt door naar de Worker. `not_found_handling` is weg
		// omdat de 404-pagina nu door Next zelf wordt gerenderd.
	},
	// Eén binding per database. `DB` is de naam waarmee worker/index.ts hem
	// aanspreekt (`env.DB`); hernoem die niet zonder de code mee te nemen.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "taalibtravels-leads",
			"database_id": "694508d6-d030-40ec-959f-9c0d933eb482",
			// Nodig voor `wrangler d1 migrations apply`; wrangler houdt in de tabel
			// `d1_migrations` bij welke bestanden al gedraaid zijn.
			"migrations_dir": "worker/migraties"
		}
	],
	// Opslag voor de foto's uit het beheerportaal. `MEDIA` is de naam waarmee de
	// Worker de bucket aanspreekt (`env.MEDIA`); hernoem die niet zonder de code mee te nemen.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "taalibtravels-media"
		}
	],
	// Per IP-adres. Turnstile en de unieke index op e-mail zijn de lagen erboven;
	// dit vangt af dat iemand het formulier of het inlogscherm plat gooit.
	"ratelimits": [
		{
			"name": "LOGIN_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "SIGNUP_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	// Cloudflare Access staat vóór /admin* en /api/admin/*; de Worker controleert
	// het token zelf (worker/access.ts). Geen geheimen: de AUD-tag staat ook in
	// elk token. Wijzig je de Access-applicatie (of verwijder je hem en maak je hem
	// opnieuw), dan krijgt hij een nieuwe AUD-tag en moet die hier mee.
	"vars": {
		"TEAM_DOMAIN": "https://taalibtravelsdomain.cloudflareaccess.com",
		"POLICY_AUD": "33cc7a09b0246cf17132b2131895616959bf43810cfe20cb641b018bbf01ad7e"
	},
	"observability": {
		"enabled": false
	},
	// Acceptatie: zelfde code en build, eigen database, bucket, domein en Access-app.
	// Deployt automatisch vanaf `acceptatie-master` (.github/workflows/deploy-acceptatie.yml).
	// Bindings, vars en ratelimits erven NIET van hierboven; routes erven WEL, en zonder
	// eigen routes zou deze Worker het productiedomein proberen over te nemen.
	// Een nieuwe binding of var hoort dus op twee plekken: hierboven én hier.
	// Elke wrangler-opdracht richting acceptatie heeft `--env acceptatie` nodig,
	// anders raakt hij productie.
	"env": {
		"acceptatie": {
			"routes": [{ "pattern": "acc.taalibtravels.com", "custom_domain": true }],
			// Expliciet herhaald, ook al erven ze `false`: zo mist niemand ze bij het lezen.
			"workers_dev": false,
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "taalibtravels-leads-acc",
					"database_id": "0f5d58f5-2517-4a3f-80da-1d714e33326a",
					"migrations_dir": "worker/migraties"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "taalibtravels-media-acc"
				}
			],
			// Eigen namespaces: met die van productie zou een klant die op acceptatie
			// test zijn eigen inlogpogingen op productie opgebruiken (sleutel = IP-adres).
			"ratelimits": [
				{
					"name": "LOGIN_LIMIT",
					"namespace_id": "2001",
					"simple": { "limit": 5, "period": 60 }
				},
				{
					"name": "SIGNUP_LIMIT",
					"namespace_id": "2002",
					"simple": { "limit": 5, "period": 60 }
				}
			],
			"vars": {
				"TEAM_DOMAIN": "https://taalibtravelsdomain.cloudflareaccess.com",
				// De AUD-tag van de Access-app op acc.taalibtravels.com, niet die van productie.
				"POLICY_AUD": "2c18185a930631b2a5f5089b7d6ec2bff4a882c36c047ba3ea3115b3565e328f"
			}
		}
	}
}